
# ===============================================================
# Practical: K-Means and Hierarchical Clustering
# Dataset: Breast Cancer (Scikit-learn)
# ===============================================================

# -----------------------------
# Step 1: Import Required Libraries
# -----------------------------
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_breast_cancer
from sklearn.cluster import KMeans
from sklearn.cluster import AgglomerativeClustering
from sklearn.preprocessing import StandardScaler

import scipy.cluster.hierarchy as sch
import os

# -------------------------------------------------
# Step 2: Load Dataset
# -------------------------------------------------
cancer = load_breast_cancer()

df = pd.DataFrame(
    cancer.data,
    columns=cancer.feature_names
)

df['Target'] = cancer.target

print("Dataset loaded successfully!")
print(df.head())

# -------------------------------------------------
# Step 3: Data Cleaning
# -------------------------------------------------
# Check missing values
print("\nMissing Values:")
print(df.isnull().sum().sum())

# Remove duplicate rows
df = df.drop_duplicates()

print("\nDataset Shape:", df.shape)

# -------------------------------------------------
# Step 4: Create Features
# -------------------------------------------------
# Select two features for visualization
X = df[['mean radius', 'mean texture']].values

# -------------------------------------------------
# Step 5: Feature Scaling
# -------------------------------------------------
scaler = StandardScaler()
X = scaler.fit_transform(X)

# -------------------------------------------------
# Step 6: Find Optimal Clusters using Elbow Method
# -------------------------------------------------
wcss = []

for i in range(1, 11):

    kmeans = KMeans(
        n_clusters=i,
        init='k-means++',
        random_state=42,
        n_init=10
    )

    kmeans.fit(X)
    wcss.append(kmeans.inertia_)

# Plot Elbow Graph
plt.figure(figsize=(5, 4))
plt.plot(range(1, 11), wcss, marker='o')
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")
plt.show()

# -------------------------------------------------
# Step 7: Apply K-Means Clustering
# -------------------------------------------------
kmeans = KMeans(
    n_clusters=2,
    init='k-means++',
    random_state=42,
    n_init=10
)

y_kmeans = kmeans.fit_predict(X)

# -------------------------------------------------
# Step 8: Visualize K-Means Clusters
# -------------------------------------------------
plt.figure(figsize=(5, 4))

plt.scatter(
    X[y_kmeans == 0, 0],
    X[y_kmeans == 0, 1],
    label="Cluster 1"
)

plt.scatter(
    X[y_kmeans == 1, 0],
    X[y_kmeans == 1, 1],
    label="Cluster 2"
)

# Plot Centroids
plt.scatter(
    kmeans.cluster_centers_[:, 0],
    kmeans.cluster_centers_[:, 1],
    s=200,
    marker='X',
    label="Centroids"
)

plt.title("K-Means Clustering")
plt.xlabel("Mean Radius (Scaled)")
plt.ylabel("Mean Texture (Scaled)")
plt.legend()
plt.show()

# -------------------------------------------------
# Step 9: Plot Dendrogram
# -------------------------------------------------
plt.figure(figsize=(7, 5))

sch.dendrogram(
    sch.linkage(
        X,
        method='ward'
    )
)

plt.title("Dendrogram")
plt.xlabel("Patients")
plt.ylabel("Euclidean Distance")
plt.show()

# -------------------------------------------------
# Step 10: Apply Hierarchical Clustering
# -------------------------------------------------
hc = AgglomerativeClustering(
    n_clusters=2,
    metric='euclidean',
    linkage='ward'
)

y_hc = hc.fit_predict(X)

# -------------------------------------------------
# Step 11: Visualize Hierarchical Clustering
# -------------------------------------------------
plt.figure(figsize=(5, 4))

plt.scatter(
    X[y_hc == 0, 0],
    X[y_hc == 0, 1],
    label="Cluster 1"
)

plt.scatter(
    X[y_hc == 1, 0],
    X[y_hc == 1, 1],
    label="Cluster 2"
)

plt.title("Hierarchical Clustering")
plt.xlabel("Mean Radius (Scaled)")
plt.ylabel("Mean Texture (Scaled)")
plt.legend()
plt.show()

# -------------------------------------------------
# Step 12: Display Cluster Labels
# -------------------------------------------------
print("\nK-Means Cluster Labels:")
print(y_kmeans)

print("\nHierarchical Cluster Labels:")
print(y_hc)

# -------------------------------------------------
# Step 13: Add Cluster Labels to Dataset
# -------------------------------------------------
df['KMeans_Cluster'] = y_kmeans
df['Hierarchical_Cluster'] = y_hc

print("\nFinal Breast Cancer Clustering:")
print(df.head(20))

# -------------------------------------------------
# End of Program
# -------------------------------------------------
