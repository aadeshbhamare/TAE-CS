
# ---------------------------------------------------------
# Linear Regression and Polynomial Regression
# California Housing Dataset
# Evaluation using MSE, MAE and R2 Score
# ---------------------------------------------------------

# ---------------------------------------------------------
# Import Libraries
# ---------------------------------------------------------

# Import NumPy library for numerical operations
import numpy as np

# Import pandas library for data manipulation
import pandas as pd

# Import matplotlib for plotting graphs
import matplotlib.pyplot as plt

# Import function to load California Housing dataset
from sklearn.datasets import fetch_california_housing

# Import function to split dataset
from sklearn.model_selection import train_test_split

# Import Linear Regression model
from sklearn.linear_model import LinearRegression

# Import PolynomialFeatures and StandardScaler
from sklearn.preprocessing import PolynomialFeatures, StandardScaler

# Import performance evaluation metrics
from sklearn.metrics import mean_squared_error
from sklearn.metrics import mean_absolute_error
from sklearn.metrics import r2_score

# ---------------------------------------------------------
# Load Dataset
# ---------------------------------------------------------

# Load built-in California Housing dataset
housing = fetch_california_housing(as_frame=True)

# Convert dataset into DataFrame
df = housing.frame.copy()

# Rename target column
df.rename(
    columns={"MedHouseVal": "median_house_value"},
    inplace=True
)

# Display first five records
print("First Five Records")
print(df.head())

# ---------------------------------------------------------
# Basic Information
# ---------------------------------------------------------

print("\nDataset Information")
df.info()

print("\nStatistical Summary")
print(df.describe())

# ---------------------------------------------------------
# Check Missing Values
# ---------------------------------------------------------

print("\nMissing Values")
print(df.isnull().sum())

# ---------------------------------------------------------
# Separate Features and Target
# ---------------------------------------------------------

# Features
X = df.drop("median_house_value", axis=1)

# Target
y = df["median_house_value"]

# ---------------------------------------------------------
# Split Dataset
# ---------------------------------------------------------

# Split dataset into 80% training and 20% testing
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

# ---------------------------------------------------------
# Linear Regression
# ---------------------------------------------------------

# Create Linear Regression model
linear_model = LinearRegression()

# Train Linear Regression model
linear_model.fit(X_train, y_train)

# Predict testing data
linear_predictions = linear_model.predict(X_test)

# ---------------------------------------------------------
# Evaluate Linear Regression
# ---------------------------------------------------------

# Calculate Mean Squared Error
linear_mse = mean_squared_error(
    y_test,
    linear_predictions
)

# Calculate Mean Absolute Error
linear_mae = mean_absolute_error(
    y_test,
    linear_predictions
)

# Calculate R2 Score
linear_r2 = r2_score(
    y_test,
    linear_predictions
)

# ---------------------------------------------------------
# Print Linear Regression Results
# ---------------------------------------------------------

print("\n----- Linear Regression Results -----")

print("Mean Squared Error :", linear_mse)

print("Mean Absolute Error :", linear_mae)

print("R2 Score :", linear_r2)

# ---------------------------------------------------------
# Polynomial Regression
# ---------------------------------------------------------

# Scale features for better numerical stability
scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)

X_test_scaled = scaler.transform(X_test)

# Create PolynomialFeatures object with degree 2
poly = PolynomialFeatures(degree=2)

# Transform training data into polynomial features
X_train_poly = poly.fit_transform(X_train_scaled)

# Transform testing data into polynomial features
X_test_poly = poly.transform(X_test_scaled)

# ---------------------------------------------------------
# Create Polynomial Regression Model
# ---------------------------------------------------------

poly_model = LinearRegression()

# Train Polynomial Regression model
poly_model.fit(X_train_poly, y_train)

# Predict testing data
poly_predictions = poly_model.predict(X_test_poly)

# ---------------------------------------------------------
# Evaluate Polynomial Regression
# ---------------------------------------------------------

# Calculate Mean Squared Error
poly_mse = mean_squared_error(
    y_test,
    poly_predictions
)

# Calculate Mean Absolute Error
poly_mae = mean_absolute_error(
    y_test,
    poly_predictions
)

# Calculate R2 Score
poly_r2 = r2_score(
    y_test,
    poly_predictions
)

# ---------------------------------------------------------
# Print Polynomial Regression Results
# ---------------------------------------------------------

print("\n----- Polynomial Regression Results -----")

print("Mean Squared Error :", poly_mse)

print("Mean Absolute Error :", poly_mae)

print("R2 Score :", poly_r2)

# ---------------------------------------------------------
# Compare Both Models
# ---------------------------------------------------------

comparison = pd.DataFrame({

    "Metric": [
        "Mean Squared Error",
        "Mean Absolute Error",
        "R2 Score"
    ],

    "Linear Regression": [
        linear_mse,
        linear_mae,
        linear_r2
    ],

    "Polynomial Regression": [
        poly_mse,
        poly_mae,
        poly_r2
    ]
})

# Display comparison table
print("\nComparison of Models")
print(comparison)

# ---------------------------------------------------------
# Visualization
# ---------------------------------------------------------

# Create figure
plt.figure(figsize=(8, 6))

# Scatter plot of Linear Regression predictions
plt.scatter(
    y_test,
    linear_predictions,
    label="Linear Regression",
    alpha=0.5
)

# Scatter plot of Polynomial Regression predictions
plt.scatter(
    y_test,
    poly_predictions,
    alpha=0.5,
    label="Polynomial Regression"
)

# Label X-axis
plt.xlabel("Actual House Prices")

# Label Y-axis
plt.ylabel("Predicted House Prices")

# Add title
plt.title("Actual vs Predicted House Prices")

# Display legend
plt.legend()

# Display graph
plt.show()

# ---------------------------------------------------------
# Practical Completed
# ---------------------------------------------------------

print("\nLinear and Polynomial Regression Completed Successfully!")
